<form class="{{cssClass}} flexcol" autocomplete="off">

  <header class="sheet-header flexrow" style="background:#1a1a2e; color:#c8d8e8; padding:8px; gap:12px; align-items:center;">
    <img class="item-image" src="{{item.img}}" data-edit="img" title="{{item.name}}"
         style="width:64px; height:64px; border:2px solid #4a90d9; border-radius:4px; cursor:pointer; object-fit:contain; flex-shrink:0;" />
    <input class="charname" name="name" type="text" value="{{item.name}}"
           style="flex:1; background:transparent; border:none; border-bottom:1px solid #4a90d9; color:#c8d8e8; font-size:1.3em; font-weight:bold; padding:2px 4px;" />
  </header>

  <section class="sheet-body" style="padding:10px 12px; overflow-y:auto; flex:1; background:#f0ece4; display:flex; flex-direction:column; gap:10px;">

    <div class="form-group flexrow" style="align-items:center; gap:8px;">
      <label style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e; white-space:nowrap;">Stacks</label>
      <input type="number" name="system.stacks" value="{{system.stacks}}" min="0" style="width:70px;" />
      <label style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e; white-space:nowrap; margin-left:12px;">Duration</label>
      <select name="system.duration.unit" style="width:140px;">
        <option value="encounter" {{#if (eq system.duration.unit "encounter")}}selected{{/if}}>Until Encounter Ends</option>
        <option value="permanent" {{#if (eq system.duration.unit "permanent")}}selected{{/if}}>Permanent</option>
      </select>
    </div>

    <div class="form-group flexrow" style="align-items:center; gap:8px;">
      <label style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e; white-space:nowrap;">Ticks Remaining</label>
      <input type="number" name="system.ticks" value="{{system.ticks}}" min="0" style="width:70px;" />
      <span style="font-size:0.78em; color:#555; font-style:italic;">0 = no automatic expiration. Otherwise decrements by 1 each time this effect's Start of Turn card is applied, and the effect is deleted when it reaches 0 — independent of Stacks (used for things like Burn's separate "number of ticks" duration).</span>
    </div>

    <div class="form-group">
      <label style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e;">Rules</label>
      <p style="margin:0 0 4px; font-size:0.78em; color:#555; font-style:italic;">What this effect actually does to whoever has it — applied automatically, no code required.</p>

      <div class="dd-rule-rows" style="display:flex; flex-direction:column; gap:4px;">
        {{#each system.rules as |rule ridx|}}
        <div class="dd-rule-row flexrow" style="align-items:center; gap:6px;">
          <select class="rule-path" data-index="{{ridx}}" style="flex:2;">
            <option value="">— choose target —</option>
            {{#each ../ruleOptions as |opt|}}
            <option value="{{opt.key}}" data-type="{{opt.type}}" {{#if (eq opt.key rule.path)}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
          <select class="rule-mode" data-index="{{ridx}}" style="flex:1;">
            <option value="add"      {{#if (eq rule.mode "add")}}selected{{/if}}>Add</option>
            <option value="subtract" {{#if (eq rule.mode "subtract")}}selected{{/if}}>Subtract</option>
            <option value="multiply" {{#if (eq rule.mode "multiply")}}selected{{/if}}>Multiply</option>
            <option value="override" {{#if (eq rule.mode "override")}}selected{{/if}}>Override</option>
          </select>
          <input type="number" class="rule-value" data-index="{{ridx}}" value="{{rule.value}}" style="width:60px;" />
          <button type="button" class="rule-remove" data-index="{{ridx}}" title="Remove rule" style="flex-shrink:0; width:auto; padding:2px 8px;">×</button>
        </div>
        {{/each}}
      </div>

      <button type="button" class="rule-add-btn" style="width:auto; padding:2px 10px; margin-top:6px;">+ Add Rule</button>
    </div>

    <div class="form-group">
      <label style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e;">Start of Turn Message</label>
      <textarea name="system.startOfTurnText" rows="3" placeholder="Message posted to chat when this effect triggers at the start of a turn…">{{system.startOfTurnText}}</textarea>
    </div>

    <div class="form-group flexrow" style="align-items:center; gap:8px;">
      <input type="checkbox" name="system.removeStackOnTurn" {{#if system.removeStackOnTurn}}checked{{/if}} style="width:16px; height:16px;" />
      <label style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e; margin:0;">Remove a Stack at Start of Turn</label>
    </div>

    <details class="dd-effect-advanced">
      <summary style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e; cursor:pointer;">Advanced</summary>

      <div class="form-group" style="margin-top:8px;">
        <label style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e;">Apply Code</label>
        <p style="margin:0 0 4px; font-size:0.78em; color:#555; font-style:italic;">For one-off cases Rules can't cover. Runs only when you click Apply on a start-of-turn card. Variables: <code>actor</code>, <code>item</code>, <code>stacks</code></p>
        <textarea name="system.applyCode" rows="5" placeholder="e.g. actor.update({'system.hp.value': Math.max(0, actor.system.hp.value - stacks)});" style="font-family:monospace; font-size:0.85em; background:#fff; border:1px solid #b0a898;">{{system.applyCode}}</textarea>
      </div>

      <div class="form-group">
        <label style="font-weight:700; font-size:0.82em; text-transform:uppercase; letter-spacing:0.04em; color:#3a3a4e;">GM Note</label>
        <p style="margin:0 0 4px; font-size:0.78em; color:#555; font-style:italic;">Flavor text only — not enforced by anything. Use Rules above for effects that should actually happen.</p>
        <textarea name="system.passiveText" rows="3" placeholder="e.g. Smells faintly of static…" style="font-family:monospace; font-size:0.85em; background:#fff; border:1px solid #b0a898;">{{system.passiveText}}</textarea>
      </div>
    </details>

  </section>

</form>
