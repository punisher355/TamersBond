<ol class="plain parties">
    {{#each parties as |party|}}
    <li class="directory-item folder flexcol{{#if party.expanded}} expanded{{/if}}" data-party data-entry-id="{{party.id}}">
        <header class="folder-header" data-action="togglePartyFolder">
            <i class="fa-solid fa-folder-open fa-fw" inert></i>
            <button type="button" class="inline-control icon fa-solid fa-file" data-action="openPartySheet"
                data-tooltip="Open Party Sheet"></button>
            {{!-- Drag preview only --}}
            <img src="{{party.img}}" hidden />
            <span class="folder-name ellipsis">{{party.name}}</span>
        </header>
        <ol class="subdirectory plain">
            {{#each party.members as |member|}}
            <li class="directory-item entry document actor flexrow" data-entry-id="{{member.id}}">
                <img class="thumbnail" src="{{member.img}}" alt="{{member.name}}" loading="lazy" />
                <a class="entry-name ellipsis" data-action="activateEntry">
                    <span>{{member.name}}</span>
                    <span class="actor-level">{{member.typeLabel}}</span>
                </a>
            </li>
            {{else}}
            <li class="blank" data-entry-id="">No members — drag an actor here</li>
            {{/each}}
        </ol>
    </li>
    {{/each}}
</ol>
