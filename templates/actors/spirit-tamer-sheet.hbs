    {{!-- Status tab --}}
    <div class="tab flexcol" data-group="primary" data-tab="status">
      <h3 class="section-header" style="margin-top:14px">Active Effects</h3>
      <div class="flexrow" style="margin-bottom:6px;">
        <button type="button" class="effect-add-btn" style="width:auto; padding:2px 10px;">+ Add Effect</button>
      </div>
      {{#if effectItems.length}}
      <div class="effect-active-list">
        {{#each effectItems}}
        <div class="effect-item-row flexrow" data-item-id="{{this.id}}" style="align-items:center; gap:6px; padding:4px 2px; border-bottom:1px solid #d0c8bc;">
          <img src="{{this.img}}" alt="" style="width:24px; height:24px; object-fit:contain; border-radius:3px; flex-shrink:0;" />
          <span class="effect-open" data-item-id="{{this.id}}" style="flex:1; cursor:pointer; font-weight:600; color:#1a1a2e; text-decoration:underline dotted;" title="Click to edit settings">{{this.name}}</span>
          <span class="flexrow" style="align-items:center; gap:2px; flex-shrink:0;">
            <button type="button" class="effect-stack-decrease rank-btn" data-item-id="{{this.id}}">−</button>
            <span style="min-width:22px; text-align:center; font-weight:700; font-size:0.95em;">{{this.system.stacks}}</span>
            <button type="button" class="effect-stack-increase rank-btn" data-item-id="{{this.id}}">+</button>
          </span>
          <button type="button" class="effect-apply-btn move-action-btn" data-item-id="{{this.id}}" title="Trigger this effect" style="padding:2px 8px; flex-shrink:0;">Apply</button>
          <button type="button" class="effect-remove move-action-btn" data-item-id="{{this.id}}" title="Remove effect" style="flex-shrink:0;"><i class="fas fa-times"></i></button>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="no-items" style="margin:2px 0 6px;">No active effects.</p>
      {{/if}}

      <h3 class="section-header" style="margin-top: 12px">Condition Reference</h3>
      <div class="status-conditions">
        <div class="status-row"><span class="status-name">BURN X,Y</span><span class="status-desc">Take X damage at start of turn. Lasts Y ticks.</span></div>
        <div class="status-row"><span class="status-name">FREEZE</span><span class="status-desc">Cannot act. End of turn: roll 1d20 + Love, DN 14 to break. Also breaks on damage.</span></div>
        <div class="status-row"><span class="status-name">PARALYZE X</span><span class="status-desc">Speed halved. 1–3 stacks: Basic OR Move only. 4+: no actions. Lose 1/turn. Nat 20 clears all.</span></div>
        <div class="status-row"><span class="status-name">BLIND</span><span class="status-desc">−4 to all attack hit rolls.</span></div>
        <div class="status-row"><span class="status-name">CONFUSE</span><span class="status-desc">Start of turn: roll 1d20 + Friendship, DN 14 to snap out. Fail: must attack nearest ally.</span></div>
        <div class="status-row"><span class="status-name">DRAIN</span><span class="status-desc">Attacker regains HP equal to half damage dealt (min 1) on hit.</span></div>
        <div class="status-row"><span class="status-name">PUSH</span><span class="status-desc">On hit, push target away. Spaces = attacker Courage − defender Courage (min 1).</span></div>
        <div class="status-row"><span class="status-name">POISON X</span><span class="status-desc">Nat 15+ on hit inflicts X stacks (add if already Poisoned). Damage = current stacks at start of turn.</span></div>
        <div class="status-row"><span class="status-name">SLEEP</span><span class="status-desc">Cannot act. Start of turn: Firewall DN 13 to wake. Breaks on any damage.</span></div>
        <div class="status-row"><span class="status-name">RECOVERY</span><span class="status-desc">Move automatically restores HP equal to its PR dice roll instead of dealing damage. No hit roll.</span></div>
        <div class="status-row"><span class="status-name">FRAGMENT X</span><span class="status-desc">Cannot regain HP from any source (RECOVERY, items, or skill checks). On hit, add X stacks. If already Fragmented, add X to current total.</span></div>
      </div>
    </div>

    {{!-- Biography tab --}}
    <div class="tab flexcol bio-tab" data-group="primary" data-tab="bio">
      <div class="bio-section">
        <h4 class="bio-section-title">The Basics</h4>
        <div class="bio-row">
          <div class="bio-field bio-field-sm">
            <label>Age</label>
            <input type="text" name="system.identity.age" value="{{system.identity.age}}" placeholder="How old are you?" />
          </div>
          <div class="bio-field bio-field-sm">
            <label>Pronouns</label>
            <input type="text" name="system.identity.pronouns" value="{{system.identity.pronouns}}" placeholder="they/them" />
          </div>
          <div class="bio-field bio-field-sm">
            <label>Primary Crest</label>
            <select name="system.identity.primaryCrest">
              <option value="" {{#unless system.identity.primaryCrest}}selected{{/unless}}>— Choose —</option>
              <option value="courage"     {{#if (eq system.identity.primaryCrest "courage")}}selected{{/if}}>Courage</option>
              <option value="friendship"  {{#if (eq system.identity.primaryCrest "friendship")}}selected{{/if}}>Friendship</option>
              <option value="love"        {{#if (eq system.identity.primaryCrest "love")}}selected{{/if}}>Love</option>
              <option value="knowledge"   {{#if (eq system.identity.primaryCrest "knowledge")}}selected{{/if}}>Knowledge</option>
              <option value="sincerity"   {{#if (eq system.identity.primaryCrest "sincerity")}}selected{{/if}}>Sincerity</option>
              <option value="reliability" {{#if (eq system.identity.primaryCrest "reliability")}}selected{{/if}}>Reliability</option>
              <option value="hope"        {{#if (eq system.identity.primaryCrest "hope")}}selected{{/if}}>Hope</option>
            </select>
          </div>
          <div class="bio-field bio-field-sm">
            <label>Digimon Species</label>
            <input type="text" name="system.digimonSpecies" value="{{system.digimonSpecies}}" placeholder="e.g. Agumon" />
          </div>
        </div>
      </div>
      <div class="bio-section">
        <h4 class="bio-section-title">Identity</h4>
        <div class="bio-field">
          <label>Appearance</label>
          <textarea name="system.identity.appearance" rows="3" placeholder="What do you look like?">{{system.identity.appearance}}</textarea>
        </div>
        <div class="bio-field">
          <label>Personality</label>
          <textarea name="system.identity.personality" rows="3" placeholder="How do you act?">{{system.identity.personality}}</textarea>
        </div>
      </div>
      <div class="bio-section">
        <h4 class="bio-section-title">Inner Life</h4>
        <div class="bio-field">
          <label>What do you want?</label>
          <textarea name="system.identity.want" rows="2" placeholder="Your goal or dream.">{{system.identity.want}}</textarea>
        </div>
        <div class="bio-field">
          <label>What do you fear?</label>
          <textarea name="system.identity.fear" rows="2" placeholder="What would break you?">{{system.identity.fear}}</textarea>
        </div>
        <div class="bio-field">
          <label>Your flaw</label>
          <textarea name="system.identity.flaw" rows="2" placeholder="What gets in your own way?">{{system.identity.flaw}}</textarea>
        </div>
      </div>
      <div class="bio-section">
        <h4 class="bio-section-title">Your Story</h4>
        <div class="bio-field">
          <label>Background</label>
          <textarea name="system.identity.background" rows="5" placeholder="Where did you come from?">{{system.identity.background}}</textarea>
        </div>
      </div>
      <div class="bio-section">
        <h4 class="bio-section-title">Notes</h4>
        <div class="bio-field">
          <textarea name="system.identity.notes" rows="4" placeholder="Secrets, connections, loose ends.">{{system.identity.notes}}</textarea>
        </div>
      </div>
    </div>

    {{!-- Digimon Stats tab --}}
    <div class="tab flexcol" data-group="primary" data-tab="digi-stats">

      <div class="tamer-link-row flexrow" style="margin-bottom:8px;">
        <label>Attribute</label>
        <select name="system.attribute" style="flex:1; max-width:140px;">
          {{selectOptions attributeOptions selected=system.attribute}}
        </select>
        <label style="margin-left:12px;">Element</label>
        <select name="system.element" style="flex:1; max-width:140px;">
          {{selectOptions elementOptions selected=system.element}}
        </select>
      </div>

      <h3 class="section-header">Combat Stats
        <span class="stage-cap-note">Tamer Bonus = your own crest rank</span>
      </h3>
      <p class="hint">Base = species/form value. Tamer Bonus = your crest ranks. Invested = Digimon EXP spent. No stage cap.</p>

      <table class="stats-table">
        <thead>
          <tr>
            <th>Stat</th>
            <th title="Species base for this form">Base</th>
            <th title="Your own crest rank for this stat">Tamer</th>
            <th title="Digimon EXP invested">Invested</th>
            <th title="Temporary buffs/debuffs">Cond.</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each digiStatList}}
          <tr>
            <td class="stat-label" style="border-left: 3px solid {{this.color}}">
              <img class="stat-crest-icon" src="{{this.crestImg}}" title="{{this.label}}" />
              <div class="stat-label-text">
                {{this.label}}
                <span class="stat-source">{{this.combatName}}</span>
              </div>
            </td>
            <td><input type="number" name="system.digiStats.{{this.key}}.base" value="{{this.base}}" /></td>
            <td class="tamer-bonus" style="color: {{this.color}}">{{this.tamerBonus}}</td>
            <td class="invested-cell">
              <div class="stat-invest-controls flexrow">
                <button type="button" class="stat-invest-btn digi-stat-decrease"
                        data-stat="{{this.key}}"
                        {{#unless this.canDowngrade}}disabled{{/unless}}
                        title="Refund 1 rank">−</button>
                <span class="stat-invest-display">{{this.invested}}</span>
                <button type="button" class="stat-invest-btn digi-stat-increase"
                        data-stat="{{this.key}}"
                        {{#unless this.canUpgrade}}disabled{{/unless}}
                        title="Invest {{this.upgradeCost}} Digimon EXP">+</button>
                <span class="stat-invest-cost">{{this.upgradeCost}}</span>
              </div>
            </td>
            <td><input type="number" name="system.digiStats.{{this.key}}.conditional" value="{{this.conditional}}" /></td>
            <td class="stat-total">{{this.total}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <p class="hint hp-formula-note" style="margin-top:8px;">
        <strong>Digimon HP Max</strong> = 20 + (Sincerity × 4) — {{digiHpFormula}}
      </p>

    </div>

    {{!-- Digivolution tab --}}
    <div class="tab flexcol" data-group="primary" data-tab="digivolution">

      <h3 class="section-header">Current Form</h3>
      {{#if currentFormData}}
      <div class="digi-current-form-card digi-form-row dd-item-row" data-item-id="{{currentFormData.id}}" draggable="true"
           title="Drag to Items sidebar to save" style="cursor:grab;">
        <div style="display:flex; align-items:flex-start; gap:10px;">
          <img src="{{currentFormData.img}}" alt="{{currentFormData.name}}"
               style="width:96px; height:96px; object-fit:contain; border:1px solid #ccc;
                      border-radius:4px; background:#f5f0e8; flex-shrink:0;" />
          <div style="flex:1; min-width:0;">
            <div class="digi-form-card-header flexrow" style="align-items:center; flex-wrap:wrap; gap:4px; margin-bottom:4px;">
              <strong class="digi-form-card-name">{{currentFormData.name}}</strong>
              <span class="tag">{{currentFormData.stageLabel}}</span>
              <span class="tag">{{currentFormData.attribute}}</span>
              <span class="tag">{{currentFormData.element}}</span>
              <button type="button" class="form-open move-action-btn" data-item-id="{{currentFormData.id}}"
                      title="Open form sheet" style="margin-left:auto;">
                <i class="fas fa-external-link-alt"></i>
              </button>
            </div>
            {{#if currentFormData.signatureMove}}
            <div class="hint" style="margin-bottom:4px;">Sig. Move: <strong>{{currentFormData.signatureMove}}</strong></div>
            {{/if}}
            <table class="stats-table digi-form-stats-mini">
              <thead><tr><th>CRG</th><th>FRD</th><th>LVE</th><th>KNW</th><th>SNC</th><th>RLB</th></tr></thead>
              <tbody>
                <tr>
                  <td class="stat-total">{{currentFormData.stats.courage}}</td>
                  <td class="stat-total">{{currentFormData.stats.friendship}}</td>
                  <td class="stat-total">{{currentFormData.stats.love}}</td>
                  <td class="stat-total">{{currentFormData.stats.knowledge}}</td>
                  <td class="stat-total">{{currentFormData.stats.sincerity}}</td>
                  <td class="stat-total">{{currentFormData.stats.reliability}}</td>
                </tr>
              </tbody>
            </table>
            {{#if currentFormData.digivolves_to.length}}
            <div class="hint" style="margin-top:4px;">
              Digivolves to: {{#each currentFormData.digivolves_to}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </div>
            {{/if}}
          </div>
        </div>
      </div>
      {{else}}
      <p class="no-items">No current form set. Drag a form from the <strong>Digimon Forms</strong> compendium, then click Set Current.</p>
      {{/if}}

      <h3 class="section-header" style="margin-top:12px;">Known Forms
        <span class="stage-cap-note">Drag from compendium to add · Drag row to Items sidebar to save</span>
      </h3>
      {{#if knownForms.length}}
      <div class="moves-list">
        {{#each knownForms}}
        <div class="move-row flexrow digi-form-row dd-item-row{{#if this.isCurrent}} move-row-active{{/if}}"
             data-item-id="{{this.id}}" draggable="true" title="Drag to Items sidebar to save" style="cursor:grab;">
          <img src="{{this.img}}" alt="{{this.name}}"
               style="width:36px; height:36px; object-fit:contain; border-radius:3px; background:#f5f0e8; flex-shrink:0;" />
          <div class="move-name-block flexcol">
            <span class="move-name">{{this.name}}</span>
            <span class="hint" style="font-size:0.8em;">{{this.stageLabel}} · {{this.system.attribute}} · {{this.system.element}}</span>
          </div>
          {{#if this.isCurrent}}<span class="tag" style="background:#27ae60;">★ Current</span>{{/if}}
          <div class="move-row-actions">
            {{#unless this.isCurrent}}
            <button type="button" class="form-set-current move-action-btn" data-item-id="{{this.id}}" title="Set as current form">
              <i class="fas fa-star"></i>
            </button>
            {{/unless}}
            <button type="button" class="form-open move-action-btn" data-item-id="{{this.id}}" title="View form">
              <i class="fas fa-eye"></i>
            </button>
            <button type="button" class="form-remove move-action-btn" data-item-id="{{this.id}}" title="Remove form">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="no-items">No known forms yet. Drag Digimon Form items here to add them.</p>
      {{/if}}

      <h3 class="section-header" style="margin-top:12px;">Stage</h3>
      <div class="digi-stage-panel">
        <div class="digi-stage-row flexrow">
          <span class="digi-stage-row-label">Current Stage</span>
          <select class="digi-stage-select" name="system.currentStage">
            {{selectOptions stageOptions selected=system.currentStage}}
          </select>
        </div>
        <div class="digi-stage-row flexrow">
          <span class="digi-stage-row-label">Default Stage</span>
          <select class="digi-stage-select" name="system.defaultStage">
            {{selectOptions stageOptions selected=system.defaultStage}}
          </select>
        </div>
        <div class="digi-stage-row flexrow">
          <span class="digi-stage-row-label">Max Default Stage</span>
          <select class="digi-stage-select" name="system.maxDefaultStage">
            {{selectOptions stageOptions selected=system.maxDefaultStage}}
          </select>
        </div>
      </div>

      <div class="digivolve-btn-panel" style="margin-top:12px;">
        {{#if system.isTamerForm}}
        <button type="button" class="revert-to-tamer-btn" disabled
                style="width:100%; padding:8px 0; margin-bottom:8px; opacity:0.5; cursor:not-allowed;">
          <i class="fas fa-user"></i> Already in Tamer Form
        </button>
        {{else}}
        <button type="button" class="revert-to-tamer-btn"
                style="width:100%; padding:8px 0; margin-bottom:8px; background:#e67e22; border-color:#c0602a; cursor:pointer; border-radius:4px;">
          <i class="fas fa-user"></i> Revert to Tamer Form
        </button>
        {{/if}}

        {{#if canDigivolve}}
        <div style="display:flex; flex-direction:column; gap:6px;">
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-size:0.9em;">
            <span>Next stage: <strong>{{digivolveTarget}}</strong></span>
            <span class="tag">Full cost: {{digivolveCost}} Hope</span>
            <span class="tag" style="background:#3498db; color:#fff;">Hope available: {{hopeAvailable}}</span>
          </div>
          <button type="button" class="digivolve-roll-btn"
                  style="padding:8px 0; font-size:1.05em; cursor:pointer; border-radius:4px;">
            <i class="fas fa-dna"></i> Digivolve to {{digivolveTarget}}!
          </button>
        </div>
        {{else}}
        {{#if noNextStageForms}}
        <p class="hint">No known forms at {{digivolveTarget}} stage yet — drag one from the Digimon Forms compendium to Known Forms first.</p>
        {{else}}
        <p class="hint">No further digivolution available from current stage.</p>
        {{/if}}
        {{/if}}
      </div>

      <h3 class="section-header" style="margin-top: 12px">Forcing a Digivolution</h3>
      <p class="hint">Spend less than the full Hope cost. Roll d100 and beat the threshold. Only in combat.</p>
      <div class="digivolution-force-table">
        <table class="stats-table">
          <thead><tr><th>Stage</th><th>Full Cost</th><th>Threshold Formula</th></tr></thead>
          <tbody>
            <tr><td>Rookie</td><td>3 Hope</td><td>(1 − spent/3) × 20 — roll above to succeed</td></tr>
            <tr><td>Champion</td><td>6 Hope</td><td>(1 − spent/6) × 35 — roll above to succeed</td></tr>
            <tr><td>Ultimate</td><td>10 Hope</td><td>(1 − spent/10) × 55 — roll above to succeed</td></tr>
            <tr><td>Mega</td><td>15 Hope</td><td>(1 − spent/15) × 80 — roll above to succeed</td></tr>
          </tbody>
        </table>
        <p class="hint">Full Hope cost = threshold 0 (always clean). At or below threshold = corruption.</p>
      </div>

      <h3 class="section-header" style="margin-top: 12px">Corruption</h3>
      <div class="corruption-panel{{#if isCorrupted}} corruption-active{{/if}}">
        <div class="corruption-header-row flexrow">
          <span class="corruption-status-label">{{#if isCorrupted}}⚠ CORRUPTED{{else}}Clean{{/if}}</span>
          <button type="button" class="corruption-toggle">
            {{#if isCorrupted}}End Corruption{{else}}Trigger Corruption{{/if}}
          </button>
        </div>
        {{#if isCorrupted}}
        <div class="bio-field">
          <label>Corrupt Form Name</label>
          <input type="text" name="system.corruption.corruptForm"
                 value="{{system.corruption.corruptForm}}"
                 placeholder="GM enters the corrupt form name" />
        </div>
        <div class="corruption-reminders">
          <p>Costs no Hope per turn. GM controlled.</p>
          <p>Targets closest Digimon or Tamer. Prefers type-advantage targets.</p>
          <p>Ends when: all enemies defeated, you are defeated, or all others submit.</p>
        </div>
        {{/if}}
      </div>

    </div>

  </section>
</form>
