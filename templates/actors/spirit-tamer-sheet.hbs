<form class="{{cssClass}} flexcol" autocomplete="off"
      style="--tamer-accent: {{system.sheetColor}}; --tamer-bg: {{system.sheetBgColor}}">

  {{!-- Corruption banner --}}
  {{#if isCorrupted}}
  <div class="corruption-banner">
    ⚠ CORRUPTED — GM Controlled — {{system.corruption.corruptForm}}
  </div>
  {{/if}}

  {{!-- Header --}}
  <header class="sheet-header flexcol">
    <input class="charname" name="name" type="text" value="{{actor.name}}" placeholder="Spirit Tamer Name" />
    {{#if system.attribute}}
    <div class="digi-quickref-bar">
      <span class="digi-quickref-pill digi-quickref-attr">{{system.attribute}}</span>
      {{#if system.element}}<span class="digi-quickref-pill digi-quickref-elem">{{system.element}}</span>{{/if}}
      {{#if system.isTamerForm}}
      <span class="digi-quickref-pill" style="background:#e67e22; color:#fff;">Tamer Form</span>
      {{else}}
      <span class="digi-quickref-pill" style="background:#6c5ce7; color:#fff;">{{currentStageLabel}}</span>
      {{/if}}
    </div>
    {{/if}}
    <div class="header-panels flexrow">

      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />

      {{!-- HP (single pool) --}}
      <div class="header-panel flexcol">
        <span class="header-panel-label">HP</span>
        <div class="hp-main-row flexrow">
          <input type="number" class="hp-value-input" name="system.digiHp.value" value="{{system.digiHp.value}}" />
          <span class="hp-sep">/</span>
          <span class="hp-max-display">{{digiHpMax}}</span>
        </div>
        <div class="hp-temp-row flexrow">
          <span class="hp-temp-label">Temp</span>
          <input type="number" class="hp-temp-input" name="system.digiHp.temp" value="{{system.digiHp.temp}}" />
        </div>
      </div>

      {{!-- Hope --}}
      <div class="header-panel flexcol">
        <span class="header-panel-label" style="color: {{hope.color}}">Hope</span>
        <div class="hope-current-row flexrow">
          <input type="number" class="hope-current-input" name="system.crests.hope.current"
                 value="{{hope.current}}" style="color: {{hope.color}}" />
          <span class="hope-sep">/</span>
          <span class="hope-max-display">{{hope.max}}</span>
        </div>
        <div class="hope-perturn-row flexrow">
          <span class="hope-pt-label">Per Turn</span>
          <input type="number" class="hope-pt-input" name="system.crests.hope.perTurn"
                 value="{{hope.perTurn}}" />
        </div>
      </div>

      {{!-- EXP panels --}}
      <div class="header-panel flexcol">
        <span class="header-panel-label">Tamer EXP</span>
        <div class="exp-line flexrow">
          <span class="exp-line-label">Total</span>
          <input type="number" name="system.exp.total" value="{{system.exp.total}}" />
        </div>
        <div class="exp-line flexrow">
          <span class="exp-line-label">Spent</span>
          <span class="exp-line-value">{{system.exp.spent}}</span>
        </div>
        <div class="exp-line flexrow">
          <span class="exp-line-label">Avail</span>
          <span class="exp-line-value exp-available">{{system.exp.available}}</span>
        </div>
      </div>

      <div class="header-panel flexcol">
        <span class="header-panel-label">Digi EXP</span>
        <div class="exp-line flexrow">
          <span class="exp-line-label">Total</span>
          <input type="number" name="system.digiExp.total" value="{{digiExp.total}}" />
        </div>
        <div class="exp-line flexrow">
          <span class="exp-line-label">Spent</span>
          <span class="exp-line-value">{{digiExp.spent}}</span>
        </div>
        <div class="exp-line flexrow">
          <span class="exp-line-label">Avail</span>
          <span class="exp-line-value exp-available">{{digiExp.available}}</span>
        </div>
      </div>

    </div>

    {{#if (or system.statusMods.cannotAct system.statusMods.forcedAttack system.statusMods.healingBlocked system.statusMods.restricted)}}
    <div class="dd-status-banner flexrow" style="gap:6px; margin-top:6px; flex-wrap:wrap;">
      {{#if system.statusMods.cannotAct}}<span class="dd-status-chip" style="background:#5dade2; color:#0a1a2e; padding:2px 8px; border-radius:10px; font-size:0.78em; font-weight:700;">⚠ Cannot Act</span>{{/if}}
      {{#if system.statusMods.restricted}}<span class="dd-status-chip" style="background:#f39c12; color:#2a1a00; padding:2px 8px; border-radius:10px; font-size:0.78em; font-weight:700;">⚠ Restricted</span>{{/if}}
      {{#if system.statusMods.forcedAttack}}<span class="dd-status-chip" style="background:#9b59b6; color:#fff; padding:2px 8px; border-radius:10px; font-size:0.78em; font-weight:700;">⚠ Forced Attack</span>{{/if}}
      {{#if system.statusMods.healingBlocked}}<span class="dd-status-chip" style="background:#3d6b6b; color:#fff; padding:2px 8px; border-radius:10px; font-size:0.78em; font-weight:700;">⚠ Healing Blocked</span>{{/if}}
    </div>
    {{/if}}
  </header>

  {{!-- Tabs --}}
  <nav class="sheet-tabs" data-group="primary">
    <a class="item" data-tab="crests">Crests</a>
    <a class="item" data-tab="skills">Skills</a>
    <a class="item" data-tab="classes">Classes</a>
    <a class="item" data-tab="combat">Combat</a>
    <a class="item" data-tab="items">Items</a>
    <a class="item" data-tab="status">Status</a>
    <a class="item" data-tab="bio">Biography</a>
    <a class="item" data-tab="digi-stats">Digimon Stats</a>
    <a class="item" data-tab="digivolution">Digivolution</a>
  </nav>

  <section class="sheet-body">

    {{!-- Crests tab --}}
    <div class="tab flexcol" data-group="primary" data-tab="crests">
      <h3 class="section-header">Crest Stats</h3>
      <div class="crests-grid">
        {{#each crestList}}
        <div class="crest-block" style="border-top: 3px solid {{this.color}}">
          <img class="crest-img" src="{{this.img}}" alt="{{this.label}}" />
          <div class="crest-content">
            <label class="crest-name" style="color: {{this.color}}">{{this.label}}</label>
            <div class="crest-rank-row flexrow">
              <button type="button" class="stat-decrease rank-btn" data-stat="{{this.key}}"
                      {{#unless this.canDowngrade}}disabled{{/unless}}>−</button>
              <span class="crest-rank-value">{{this.rank}}</span>
              <button type="button" class="stat-increase rank-btn" data-stat="{{this.key}}"
                      {{#unless this.canUpgrade}}disabled{{/unless}}>+</button>
            </div>
            <span class="crest-arrow">→ {{this.digimonStat}}</span>
            <div class="crest-modifiers">
              <div class="crest-mod-row flexrow">
                <span class="crest-mod-label">Manual</span>
                <input type="number" class="crest-mod-input"
                       name="system.crests.{{this.key}}.modifier" value="{{this.modifier}}" />
              </div>
              <div class="crest-mod-row flexrow">
                <span class="crest-mod-label">Buffs</span>
                <span class="crest-mod-auto">{{this.autoModifier}}</span>
              </div>
              {{#if this.showEffective}}
              <div class="crest-mod-row crest-effective-row flexrow">
                <span class="crest-mod-label">Total</span>
                <span class="crest-effective-value">{{this.effective}}</span>
              </div>
              {{/if}}
            </div>
            {{#if this.upgradeCost}}
            <span class="crest-cost">Next: {{this.upgradeCost}} EXP</span>
            {{else}}
            <span class="crest-cost crest-maxed">MAX</span>
            {{/if}}
          </div>
        </div>
        {{/each}}

        <div class="crest-block hope-block" style="border-top: 3px solid {{hope.color}}">
          <img class="crest-img" src="{{hope.img}}" alt="Hope" />
          <div class="crest-content">
            <label class="crest-name" style="color: {{hope.color}}">Hope</label>
            <div class="crest-rank-row flexrow">
              <span class="crest-rank-value hope-pool" style="color: {{hope.color}}">{{hope.max}}</span>
            </div>
            <span class="crest-arrow">→ Digivolution pool</span>
            <span class="crest-cost">Based on total EXP</span>
          </div>
        </div>
      </div>
    </div>

    {{!-- Skills tab --}}
    <div class="tab flexcol" data-group="primary" data-tab="skills">
      {{#each skillGroups}}
      <div class="skill-group">
        <div class="skill-group-header flexrow" style="border-left-color: {{this.statColor}}">
          <span class="skill-stat-name" style="color: {{this.statColor}}">{{this.statLabel}}</span>
          <span class="skill-stat-rank">Rank {{this.statRank}}</span>
        </div>
        {{#each this.skills}}
        <div class="skill-row flexrow{{#if this.isPrestige}} skill-prestige{{/if}}{{#if this.atCap}} skill-at-cap{{/if}}">
          <span class="skill-name" data-tip-title="{{this.label}}"
                data-tip-desc="{{this.description}}" data-tip-example="{{this.example}}">{{this.label}}</span>
          <span class="skill-formula">{{this.rollFormula}}</span>
          <div class="skill-rank-controls flexrow">
            <button type="button" class="skill-decrease rank-btn" data-stat="{{../statKey}}" data-skill="{{this.key}}"
                    {{#unless this.canDowngrade}}disabled{{/unless}}>−</button>
            <span class="skill-rank{{#if this.isPrestige}} skill-rank-prestige{{/if}}">{{this.rank}}</span>
            <button type="button" class="skill-increase rank-btn" data-stat="{{../statKey}}" data-skill="{{this.key}}"
                    {{#unless this.canUpgrade}}disabled{{/unless}}>+</button>
          </div>
          {{#if this.upgradeCost}}
          <span class="skill-cost">{{this.upgradeCost}}</span>
          {{else}}
          <span class="skill-cost skill-maxed">MAX</span>
          {{/if}}
          <button type="button" class="skill-roll-btn" data-stat="{{../statKey}}" data-skill="{{this.key}}"
                  data-label="{{this.label}}" title="Roll {{this.rollFormula}}">
            <i class="fas fa-dice-d6"></i>
          </button>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>

    {{!-- Classes tab --}}
    <div class="tab flexcol" data-group="primary" data-tab="classes">
      <h3 class="section-header">Class Abilities
        <span class="stage-cap-note">EXP comes from the Tamer EXP pool</span>
      </h3>
      {{#if classItems.length}}
      <div class="class-items-list">
        {{#each classItems}}
        <div class="class-item-card dd-item-row" data-item-id="{{this.id}}" draggable="true" style="cursor:grab;">
          <div class="class-item-header flexrow">
            <img src="{{this.img}}" alt="" style="width:32px; height:32px; object-fit:contain; border-radius:3px; flex-shrink:0;" />
            <span class="class-item-name class-item-open" data-item-id="{{this.id}}" style="cursor:pointer;" title="Open item sheet">{{this.name}}</span>
            <span class="tag class-item-tree">{{this.system.class}}</span>
            <span class="tag class-item-row-tag">Row {{this.system.row}}</span>
            <span class="class-item-cost">{{this.system.expCost}} EXP</span>
            <button type="button" class="class-item-hud-pin{{#if (includes ../pinnedSkillIds this.id)}} cs-pinned{{/if}}"
                    data-item-id="{{this.id}}"
                    title="{{#if (includes ../pinnedSkillIds this.id)}}Pinned to action bar — click to unpin{{else}}Pin to action bar{{/if}}">
              <i class="fas fa-thumbtack"></i>
            </button>
            <button type="button" class="class-item-to-chat" data-item-id="{{this.id}}" title="Post to chat">
              <i class="fas fa-comment"></i>
            </button>
            <button type="button" class="class-item-delete" data-item-id="{{this.id}}" title="Remove ability">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          {{#if this.system.requirements}}
          <p class="class-item-req"><em>Req: {{this.system.requirements}}</em></p>
          {{/if}}
          <p class="class-item-desc">{{this.system.description}}</p>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="placeholder-text">No class abilities yet. Drag abilities from the <strong>Tamer Classes</strong> compendium to add them.</p>
      {{/if}}
    </div>

    {{!-- Combat tab --}}
    <div class="tab flexcol" data-group="primary" data-tab="combat">

      {{#if attacks.length}}
      <h3 class="section-header">Attacks
        <span class="stage-cap-note">Drag Attack items here to add</span>
      </h3>
      <div class="moves-list" style="margin-top:4px; margin-bottom:10px;">
        {{#each attacks}}
        <div class="move-row flexrow dd-item-row" data-item-id="{{this.id}}" draggable="true" style="cursor:grab;">
          <img src="{{this.img}}" alt="" style="width:32px; height:32px; object-fit:contain; border-radius:3px; flex-shrink:0;" />
          <div class="move-name-block flexcol">
            <span class="move-name attack-open" data-item-id="{{this.id}}" style="cursor:pointer;">{{this.name}}</span>
            {{#if this.tagsString}}<span class="move-tags-string">{{this.tagsString}}</span>{{/if}}
            {{#if this.system.effect}}<span class="move-effect">{{this.system.effect}}</span>{{/if}}
          </div>
          {{#if (eq this.system.actionType "attack")}}
          <span class="tag move-element-tag">{{this.system.element}}</span>
          <span class="tag move-pr-tag">PR {{this.system.pr}}</span>
          {{/if}}
          {{#if (eq this.system.actionType "utility")}}
          <span class="tag" style="background:#888;">FREE</span>
          {{/if}}
          <div class="move-row-actions">
            <button type="button" class="attack-roll move-action-btn" data-item-id="{{this.id}}" title="Use / Roll">
              <i class="fas fa-dice-d20"></i>
            </button>
            <button type="button" class="attack-delete move-action-btn" data-item-id="{{this.id}}" title="Remove">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}

      <h3 class="section-header">Current Moves
        <span class="stage-cap-note">{{activeCount}}/3 learned slots</span>
      </h3>
      <p class="hint">Your active moves for this session. Change selections at long rest.</p>

      {{#if sigMove}}
      <div class="moves-list">
        <div class="move-row flexrow move-row-sig dd-item-row" data-item-id="{{sigMove.id}}" draggable="true" style="cursor:grab;">
          <img src="{{sigMove.img}}" alt="" style="width:32px; height:32px; object-fit:contain; border-radius:3px; flex-shrink:0;" />
          <div class="move-name-block flexcol">
            <span class="move-name move-open" data-item-id="{{sigMove.id}}" style="cursor:pointer;" title="Open item sheet">{{sigMove.name}}</span>
            {{#if sigMove.tagsString}}<span class="move-tags-string">{{sigMove.tagsString}}</span>{{/if}}
            {{#if sigMove.system.effect}}<span class="move-effect">{{sigMove.system.effect}}</span>{{/if}}
          </div>
          <span class="tag move-element-tag">{{sigMove.system.element}}</span>
          <span class="tag move-pr-tag">PR {{sigMove.system.pr}}</span>
          <span class="tag move-stage-tag">{{sigMove.system.minStage}}+</span>
          <span class="tag move-sig">★ Sig</span>
          <div class="move-row-actions">
            <button type="button" class="attack-roll move-action-btn" data-item-id="{{sigMove.id}}" title="Roll">
              <i class="fas fa-dice-d20"></i>
            </button>
            <button type="button" class="move-to-chat move-action-btn" data-item-id="{{sigMove.id}}" title="Post to chat">
              <i class="fas fa-comment"></i>
            </button>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if activeMoves.length}}
      <div class="moves-list">
        {{#each activeMoves}}
        <div class="move-row flexrow move-row-active dd-item-row" data-item-id="{{this.id}}" draggable="true" style="cursor:grab;">
          <img src="{{this.img}}" alt="" style="width:32px; height:32px; object-fit:contain; border-radius:3px; flex-shrink:0;" />
          <div class="move-name-block flexcol">
            <span class="move-name move-open" data-item-id="{{this.id}}" style="cursor:pointer;" title="Open item sheet">{{this.name}}</span>
            {{#if this.tagsString}}<span class="move-tags-string">{{this.tagsString}}</span>{{/if}}
            {{#if this.system.effect}}<span class="move-effect">{{this.system.effect}}</span>{{/if}}
          </div>
          <span class="tag move-element-tag">{{this.system.element}}</span>
          <span class="tag move-pr-tag">PR {{this.system.pr}}</span>
          <span class="tag move-stage-tag">{{this.system.minStage}}+</span>
          <div class="move-row-actions">
            <button type="button" class="attack-roll move-action-btn" data-item-id="{{this.id}}" title="Roll">
              <i class="fas fa-dice-d20"></i>
            </button>
            <button type="button" class="move-to-chat move-action-btn" data-item-id="{{this.id}}" title="Post to chat">
              <i class="fas fa-comment"></i>
            </button>
            <button type="button" class="move-deactivate move-action-btn" data-item-id="{{this.id}}" title="Remove from active moves">
              <i class="fas fa-minus-circle"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="no-items">No active moves chosen — select from the Move Pool below.</p>
      {{/if}}

      <h3 class="section-header" style="margin-top: 12px">Move Pool
        <span class="stage-cap-note">Drag Move items from the sidebar to add</span>
      </h3>
      <p class="hint">All known moves. Click the checkmark to set as active (max 3). Signature move is always available.</p>

      {{#if poolMoves.length}}
      <div class="moves-list">
        {{#each poolMoves}}
        <div class="move-row flexrow dd-item-row{{#if this.system.isSignature}} move-row-sig{{/if}}{{#if this.isActive}} move-row-active{{/if}}" data-item-id="{{this.id}}" draggable="true" style="cursor:grab;">
          <img src="{{this.img}}" alt="" style="width:32px; height:32px; object-fit:contain; border-radius:3px; flex-shrink:0;" />
          <div class="move-name-block flexcol">
            <span class="move-name move-open" data-item-id="{{this.id}}" style="cursor:pointer;" title="Open item sheet">{{this.name}}</span>
            {{#if this.tagsString}}<span class="move-tags-string">{{this.tagsString}}</span>{{/if}}
            {{#if this.system.effect}}<span class="move-effect">{{this.system.effect}}</span>{{/if}}
          </div>
          <span class="tag move-element-tag">{{this.system.element}}</span>
          <span class="tag move-pr-tag">PR {{this.system.pr}}</span>
          <span class="tag move-stage-tag">{{this.system.minStage}}+</span>
          {{#if this.system.isSignature}}<span class="tag move-sig">★ Sig</span>{{/if}}
          {{#if this.isActive}}<span class="tag" style="background:#27ae60;">✓ Active</span>{{/if}}
          <div class="move-row-actions">
            {{#if this.canActivate}}
            <button type="button" class="move-activate move-action-btn" data-item-id="{{this.id}}" title="Set as active move">
              <i class="fas fa-check-circle"></i>
            </button>
            {{/if}}
            {{#if this.canDeactivate}}
            <button type="button" class="move-deactivate move-action-btn" data-item-id="{{this.id}}" title="Remove from active moves">
              <i class="fas fa-minus-circle"></i>
            </button>
            {{/if}}
            <button type="button" class="move-to-chat move-action-btn" data-item-id="{{this.id}}" title="Post to chat">
              <i class="fas fa-comment"></i>
            </button>
            <button type="button" class="move-delete move-action-btn" data-item-id="{{this.id}}" title="Remove move">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="no-items">No moves in pool. Drag Move items from the sidebar to add them.</p>
      {{/if}}

      <div class="tamer-action-table">
        <div class="tamer-action-table-header">Basic Actions <span class="tamer-action-limit">once per round</span></div>
        <div class="tamer-action-row">
          <span class="tamer-action-name">Attack</span>
          <div class="tamer-action-body">
            <span class="tamer-action-desc">Use one of your Moves or Attacks.</span>
          </div>
        </div>
        <div class="tamer-action-row">
          <span class="tamer-action-name">Use Item</span>
          <div class="tamer-action-body">
            <span class="tamer-action-desc">Use a carried item from your inventory.</span>
          </div>
        </div>
        <div class="tamer-action-row">
          <span class="tamer-action-name">Push Through <span class="tamer-once-badge">once/encounter</span></span>
          <div class="tamer-action-body">
            <span class="tamer-action-desc">Roll a relevant skill. Restore Hope equal to the result.</span>
            <button type="button" class="tamer-action-btn" data-action="push-through"><i class="fas fa-dice-d6"></i> Roll</button>
          </div>
        </div>
      </div>

      <div class="tamer-action-table" style="margin-top:6px;">
        <div class="tamer-action-table-header">Free Actions <span class="tamer-action-limit">once per round</span></div>
        <div class="tamer-action-row">
          <span class="tamer-action-name">Call Out</span>
          <div class="tamer-action-body">
            <span class="tamer-action-desc">Partner gains +1 to their next attack roll this round.</span>
            <button type="button" class="tamer-action-btn" data-action="call-out"><i class="fas fa-bullhorn"></i> Use</button>
          </div>
        </div>
      </div>

    </div>

    {{!-- Items tab --}}
    <div class="tab flexcol" data-group="primary" data-tab="items">

      <div class="items-tab-toolbar">
        <button type="button" class="open-item-lookup">
          <i class="fas fa-shopping-bag"></i> Browse &amp; Add Items
        </button>
      </div>

      <h3 class="section-header">Currency</h3>
      <div class="currency-panel flexrow">
        <div class="currency-field flexcol">
          <label>DigiDollars (DD)</label>
          <input type="number" name="system.currency.digidollars" value="{{system.currency.digidollars}}" />
        </div>
        <div class="currency-field flexcol">
          <label>Real World Money</label>
          <input type="number" name="system.currency.realMoney" value="{{system.currency.realMoney}}" />
        </div>
      </div>

      <h3 class="section-header" style="margin-top:10px;">Equipment Slots</h3>
      {{#each gearSlots}}
      <div class="gear-slot-block">
        <div class="gear-slot-header flexrow">
          <span class="gear-slot-label">{{this.label}}</span>
          {{#if this.equipped}}
          <img src="{{this.equipped.img}}" alt="" style="width:28px; height:28px; object-fit:contain; border-radius:3px; flex-shrink:0;" />
          <span class="gear-equipped-name gear-open dd-item-row" data-item-id="{{this.equipped.id}}" draggable="true" style="cursor:grab;">{{this.equipped.name}}</span>
          <button type="button" class="gear-to-chat gear-action-btn" data-item-id="{{this.equipped.id}}" title="Post to chat"><i class="fas fa-comment"></i></button>
          <button type="button" class="gear-unequip gear-action-btn" data-item-id="{{this.equipped.id}}" title="Unequip"><i class="fas fa-minus-circle"></i></button>
          {{else}}
          <span class="gear-slot-empty">— empty —</span>
          {{/if}}
        </div>
        {{#each this.all}}
        {{#unless this.system.isEquipped}}
