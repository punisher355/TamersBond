{"_id":"0104a4a245d16648","name":"Boundless Hope","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK","row":2,"expCost":500,"requirements":"Highest Crest Stat rank 4+","description":"Your maximum Hope Pool permanently increases by 25."}}
{"_id":"034c5c644f0b9ee9","name":"Break Through","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari","row":1,"expCost":300,"requirements":"Highest Crest Stat rank 2+","description":"Once per round, when your Digimon makes an attack, you may spend 8 Hope to ignore the target's Attribute and Element matchup. For that attack, treat your Digimon as having the ideal matchup against the target."}}
{"_id":"0ad20ed4d20809b0","name":"Constant Call","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tai.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tai","row":2,"expCost":400,"requirements":"Courage rank 3+","description":"Whenever you use Call Out, the Digimon benefiting from it adds your Courage rank to the attack roll instead of the normal +1 bonus."}}
{"_id":"0da4fbbbf10d6070","name":"Data Scan","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Izzy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Izzy","row":1,"expCost":200,"requirements":"Knowledge rank 2+","description":"As a Basic Action, choose one enemy Digimon. You learn their Attribute (Vaccine, Data, Virus, Free, or Unknown)."}}
{"_id":"0ee3a2c4fc0acc1e","name":"Never Too Late","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Sora.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Sora","row":2,"expCost":500,"requirements":"Love rank 5+","description":"Once per encounter, when an allied Digimon would enter Egg State, you may immediately spend 10 Hope to prevent it. That Digimon instead stabilizes at In-Training Stage with 1 HP."}}
{"_id":"12b61e3c81d60e70","name":"Rally the Team","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tai.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tai","row":3,"expCost":700,"requirements":"Courage rank 6+","description":"When you use Lead From the Front, you may choose up to 3 allied Digimon instead of one."}}
{"_id":"16233cc60c2d6b72","name":"Source Code","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Izzy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Izzy","row":3,"expCost":700,"requirements":"Knowledge rank 6+","description":"As your Basic Action, make a Jack In check against DN 20. On a success, you may change one minor thing about the Digital World in your immediate surroundings, such as cracking a boulder apart or causing a door into a nearby building to appear, that scale of edit. This can never be used to change anything about a Digimon, and it can't be used to make a major change to the environment around you, like turning a desert into an ocean."}}
{"_id":"1e3fb1dfa6d95060","name":"Elemental Analysis","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Izzy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Izzy","row":2,"expCost":400,"requirements":"Knowledge rank 4+","description":"Data Scan also reveals the target's Element."}}
{"_id":"2450de7dc1de1160","name":"Everyone's Angle","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari","row":2,"expCost":400,"requirements":"Highest Crest Stat rank 4+","description":"Break Through can now be used when any allied Digimon makes an attack. You pay the Hope cost yourself."}}
{"_id":"2526b01db7564ee3","name":"Heart of the Team","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Sora.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Sora","row":2,"expCost":500,"requirements":"Love rank 4+","description":"Rally Cry no longer costs Hope to use."}}
{"_id":"30d80abd4854d22a","name":"No Retreat","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tai.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tai","row":2,"expCost":500,"requirements":"Courage rank 4+","description":"When your Digimon hits 0 HP while above Default Stage, before the cascade triggers you may spend 5 Hope to keep them at 1 HP and hold their current stage until the end of the round."}}
{"_id":"31fea023a6cbb146","name":"Just In Case","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Joe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Joe","row":3,"expCost":600,"requirements":"Reliability rank 6+","description":"Once between rests, as your Basic Action, declare that you happen to have one Supply item on hand that you hadn't listed before. You must use it immediately, as though you'd been carrying it the whole time."}}
{"_id":"33c27ea0e05583d2","name":"Steady Hands","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Joe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Joe","row":1,"expCost":250,"requirements":"Reliability rank 2+","description":"Once between rests, you may make a Recovery check. Choose one Digimon or Tamer; they heal HP equal to the result of that check."}}
{"_id":"3e463a34e74f9296","name":"Rally the Team","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Sora.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Sora","row":2,"expCost":400,"requirements":"Love rank 4+","description":"Rally Cry can now target up to 3 allied Digimon at once instead of just one."}}
{"_id":"3fba00513d8e0d2c","name":"Gatomon's Legacy","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari","row":3,"expCost":700,"requirements":"Highest Crest Stat rank 6+","description":"Your Digimon's Max Default Stage increases by 1 permanently. Their Default Stage can now reach one stage higher than the campaign maximum allowed for other Digimon. This cannot increase their Default Stage beyond Mega."}}
{"_id":"410d483b983c8729","name":"Pack Bond","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Matt.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Matt","row":2,"expCost":500,"requirements":"Friendship rank 4+","description":"Whenever you use Cold Front, the allied Digimon it protects gains a bonus to their next damage roll against the attacking Digimon equal to whatever was rolled for Cold Front."}}
{"_id":"42f31dbad06fef48","name":"Push the Limit","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tai.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tai","row":3,"expCost":800,"requirements":"Courage rank 6+","description":"Your Digimon may digivolve up to 3 stages above Default Stage instead of the normal 2 stage maximum. The Hope costs and corruption rules still apply."}}
{"_id":"4464c5f51442524c","name":"Rally Cry","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Sora.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Sora","row":1,"expCost":300,"requirements":"Love rank 2+","description":"As a Basic Action, choose yourself or an allied Digimon and spend 3 Hope to remove one stack of any status effect currently affecting them."}}
{"_id":"4865e2c99dc247a6","name":"Cheer","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari","row":2,"expCost":300,"requirements":"Highest Crest Stat rank 4+","description":"When an ally fails a skill check, you may spend Hope equal to your rank in the Crest Stat used for that check. Add that amount to the ally's result. You may use Cheer after seeing the roll, but before the GM determines the outcome."}}
{"_id":"4ade2619b3555486","name":"Wide Scan","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Izzy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Izzy","row":2,"expCost":500,"requirements":"Knowledge rank 4+","description":"You may use Data Scan at the start of the encounter without it costing an action."}}
{"_id":"5263fb0e1f767503","name":"Clean Sweep","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Sora.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Sora","row":3,"expCost":600,"requirements":"Love rank 6+","description":"Rally Cry now removes all stacks of all negative status effects affecting the chosen Digimon."}}
{"_id":"52759d30f29ff107","name":"Stronger Together","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Matt.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Matt","row":2,"expCost":500,"requirements":"Friendship rank 4+","description":"Whenever you use Cold Front, add your Friendship rank to the amount rolled."}}
{"_id":"71c85ad5229c5403","name":"Hope Spreads","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK","row":3,"expCost":800,"requirements":"Highest Crest Stat rank 6+","description":"Whenever you use Pass It On, you may choose a second, different Tamer to also receive that same amount of Hope, at no additional cost to you."}}
{"_id":"7401edb0102f7a68","name":"Shared Resolve","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Mimi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Mimi","row":2,"expCost":500,"requirements":"Sincerity rank 4+","description":"While Harder Than I Look is active on your partner Digimon, allied Digimon within 3 spaces of your partner also gain +2 damage."}}
{"_id":"788f13b72a2d4678","name":"Double Charge","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Joe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Joe","row":2,"expCost":400,"requirements":"Reliability rank 4+","description":"Your equipped Gadget's uses are doubled before it needs to refresh at a rest."}}
{"_id":"7ae95014aefc00e0","name":"Pure Heart","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Mimi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Mimi","row":2,"expCost":500,"requirements":"Sincerity rank 4+","description":"Once per encounter, as a Free Action, choose one Digimon within 5 spaces and make a Tame check against DN 15. On a success, that Digimon loses its next action. If it is not attacked before that action would occur, the GM may allow the scene to shift into dialogue rather than combat. Some Digimon hold nothing in their hearts but evil and hate, and opening a dialogue with something like that might be pointless; that's a call for the table to make in the moment, not a guarantee this ability provides."}}
{"_id":"7e42f40bebeb0f6a","name":"Never Truly Empty","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK","row":3,"expCost":700,"requirements":"Highest Crest Stat rank 6+","description":"Once per encounter, if you would hit 0 Hope for any reason, you may instead restore half your Hope. If you hit 0 Hope specifically from the start of turn deduction, you still dedigivolve as normal."}}
{"_id":"7f2fde09a8020962","name":"Full Force","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Mimi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Mimi","row":3,"expCost":750,"requirements":"Sincerity rank 6+","description":"While Harder Than I Look is active, its bonus becomes +Sincerity to attack rolls and +Sincerity to damage rolls, replacing its normal +2 damage bonus."}}
{"_id":"9179e408c44f8d76","name":"The Mimi Effect","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Mimi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Mimi","row":3,"expCost":800,"requirements":"Sincerity rank 6+","description":"Once per encounter, as a Basic Action, activate The Mimi Effect. Until the start of your next turn, enemies attacking you or an allied Digimon take a penalty to their attack rolls equal to your Sincerity rank."}}
{"_id":"a497d8a7ccb3c616","name":"Talk Them Down","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Sora.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Sora","row":3,"expCost":700,"requirements":"Love rank 6+","description":"As a Basic Action, make a Tame check against DN 15 targeting a Dark Digivolution. On a success, it calms, forcibly dedigivolving back to its Default Stage, and it leaves the battle."}}
{"_id":"a68591de03d03154","name":"Perfect Timing","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK","row":2,"expCost":400,"requirements":"Highest Crest Stat rank 4+","description":"You may use your Basic Action immediately before an ally's turn begins to activate Pass It On. The Hope is provided before the start of their turn, allowing it to be used to pay their Digimon's maintenance cost and prevent it from de-digivolving."}}
{"_id":"b14aa417ddf95338","name":"Never Empty-Handed","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK","row":2,"expCost":500,"requirements":"Highest Crest Stat rank 4+","description":"Pass It On is no longer limited to once per encounter. You may use it as your Basic Action as often as you have a Basic Action to spend."}}
{"_id":"b94cb76f572218eb","name":"Burning Courage","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tai.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tai","row":2,"expCost":500,"requirements":"Courage rank 3+","description":"Once per round, you may use Lead From the Front as its own action. This use does not use your Free Action, allowing you to use Lead From the Front twice on the same Digimon in a single round: once normally by spending your Free Action, and once using Lead From the Front as its own action."}}
{"_id":"b968e4fc166d8cb0","name":"Push Further","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari","row":2,"expCost":500,"requirements":"Highest Crest Stat rank 4+","description":"Break Through now costs 4 Hope instead of 8."}}
{"_id":"c19efaca478d8513","name":"Lead From the Front","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tai.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tai","row":1,"expCost":200,"requirements":"Courage rank 2+","description":"You may use Call Out on an allied Digimon instead of your own partner. When you do, that Digimon gains the normal bonus from Call Out to their next attack this round. Lead From the Front still uses your Free Action, just like a normal use of Call Out. This does not replace or prevent you from using Call Out on your own Digimon; you may still use Call Out normally on your partner, and all bonuses that apply when using Lead From the Front also apply when using Call Out."}}
{"_id":"c6c53669c62e79fb","name":"Better Safe Than Sorry","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Joe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Joe","row":3,"expCost":700,"requirements":"Reliability rank 6+","description":"When Steady Hands restores more HP than the target can recover, the excess becomes Temporary HP instead of being wasted. If the target is already at maximum HP, the entire amount restored by Steady Hands becomes Temporary HP."}}
{"_id":"c8a2fd06d47390b0","name":"Stand Together","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Matt.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Matt","row":3,"expCost":700,"requirements":"Friendship rank 6+","description":"Cold Front can now target any allied Digimon anywhere on the battlefield, not just within 3 spaces. You can use Cold Front once per round instead of once per encounter."}}
{"_id":"d0075711149dab85","name":"Light the Way","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari","row":3,"expCost":700,"requirements":"Highest Crest Stat rank 6+","description":"You can use Break Through on every attack. It is no longer limited to once per round."}}
{"_id":"d255633de8610b45","name":"Solo Run","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Matt.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Matt","row":2,"expCost":400,"requirements":"Friendship rank 3+","description":"Whenever your Digimon is the only Digimon currently active on your side, they gain a bonus to all attack rolls and damage rolls equal to your Friendship rank."}}
{"_id":"d73d91e098a0e583","name":"Warp Digivolution","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Matt.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Matt","row":3,"expCost":700,"requirements":"Friendship rank 6+","description":"Your Digimon can now digivolve two stages at once in a single Digivolving Action, skipping the stage in between. Pay the combined Hope cost of both stages minus 2 to initiate the Warp Digivolution. While Warp Digivolved, your Digimon's Hope cost per Tamer turn is equal to the combined Hope cost of the two stages minus 2. For example, if your Digimon digivolves from Rookie to Ultimate, the normal Hope cost is Champion (6) plus Ultimate (10) for 16 Hope per Tamer turn; with Warp Digivolution the cost is 14 Hope per Tamer turn. Warp Digivolution cannot be forced, the full initiation cost must always be paid, and all other digivolution rules apply normally."}}
{"_id":"df1e6c4d6d9a672c","name":"Extra Dose","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Joe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Joe","row":2,"expCost":400,"requirements":"Reliability rank 4+","description":"Steady Hands' healing also gets +1d8 added to the roll."}}
{"_id":"e2c2718a4be850f4","name":"Digimon Encyclopedia","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Izzy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Izzy","row":3,"expCost":600,"requirements":"Knowledge rank 6+","description":"Data Scan now targets every enemy Digimon in the encounter at once instead of just one."}}
{"_id":"e31a5962358f56c1","name":"Harder Than I Look","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Mimi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Mimi","row":1,"expCost":250,"requirements":"Sincerity rank 2+","description":"While your partner Digimon is at or below half of its maximum HP, it gains +2 damage on all attacks."}}
{"_id":"e6e0aa354aa2335b","name":"Root Access","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Izzy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Izzy","row":2,"expCost":500,"requirements":"Knowledge rank 4+","description":"Add your Knowledge rank to the result of all Jack In skill checks."}}
{"_id":"e6f28b8fbc4a42fe","name":"Making the Rounds","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Joe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Joe","row":2,"expCost":500,"requirements":"Reliability rank 4+","description":"Steady Hands is no longer limited to one use between rests total. Instead, you may use it once on each Digimon or Tamer between rests, rather than just once overall."}}
{"_id":"ed315dabe9894c01","name":"Cold Front","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Matt.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Matt","row":1,"expCost":250,"requirements":"Friendship rank 2+","description":"Once per encounter, when you or an allied Tamer or Digimon within 3 spaces of you is attacked, you may use your Free Action to subtract 1d8 from the damage they take."}}
{"_id":"f21843ee81a4bab5","name":"Quick to Anger","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Mimi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Mimi","row":2,"expCost":450,"requirements":"Sincerity rank 4+","description":"Harder Than I Look activates whenever your partner Digimon is at or below 75% of its maximum HP."}}
{"_id":"fdc672e18f858e66","name":"Pass It On","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK","row":1,"expCost":250,"requirements":"Highest Crest Stat rank 2+","description":"Once per encounter, as your Basic Action, choose another allied Tamer. Give them Hope from your own pool, up to their maximum Hope. You cannot give away more Hope than you currently have, and this can never take you below 0."}}
