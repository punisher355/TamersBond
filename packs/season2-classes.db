{"_id":"078a8619dba62689","name":"Ready Again","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari S2","row":2,"expCost":500,"requirements":"Highest Crest Stat rank 4+","description":"Untouchable is no longer limited to once between rests. You may use it once per encounter instead."}}
{"_id":"07cd32494d3df114","name":"Full Throttle","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Davis.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Davis","row":2,"expCost":450,"requirements":"Courage rank 4+","description":"Reckless's bonus die increases from 1d4 to 1d8. Enemies attacking your Digimon this round only gain half of that rolled bonus, rounded down, instead of the full amount."}}
{"_id":"0a597f7246c13203","name":"Boundless Reach","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK S2","row":2,"expCost":450,"requirements":"Highest Crest Stat rank 4+","description":"Hope Beacon now applies to all allies, regardless of range."}}
{"_id":"0becde8d241b818c","name":"Opportunist","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Ken.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Ken","row":1,"expCost":250,"requirements":"Highest Crest Stat rank 2+","description":"When any Digimon within 3 spaces of your partner Digimon rolls a natural 1 and misses with an attack, your Digimon may use their Free Action to make an attack against that Digimon."}}
{"_id":"0f1d364fad22852a","name":"Fed by Light","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari S2","row":2,"expCost":450,"requirements":"Highest Crest Stat rank 4+","description":"Whenever your partner Digimon takes damage from a Light attack, you may gain 8 Hope."}}
{"_id":"14f6085ed24aa5c9","name":"Clean Technique","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Cody.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Cody","row":2,"expCost":450,"requirements":"Reliability rank 4+","description":"Guard Stance no longer reduces the damage your Digimon deals."}}
{"_id":"16b4d737fac431e1","name":"Gentle Toll","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari S2","row":2,"expCost":400,"requirements":"Highest Crest Stat rank 4+","description":"Untouchable's cost is reduced from 10 Hope to 4 Hope."}}
{"_id":"1f1c569abec8be2f","name":"Borrowed Time","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK S2","row":3,"expCost":750,"requirements":"Highest Crest Stat rank 6+","description":"Once per rest, when your Digimon would revert due to Hope running out, you may spend any amount of remaining Hope, even 0, to delay the reversion until the start of your next turn."}}
{"_id":"200647f0dcadb4b9","name":"Lighter Load","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK S2","row":2,"expCost":450,"requirements":"Highest Crest Stat rank 4+","description":"Hope Beacon's cost is reduced from 25 Hope to 15 Hope."}}
{"_id":"2ad3fc2f7e5e9192","name":"Cutting Corners","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Davis.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Davis","row":2,"expCost":400,"requirements":"Courage rank 4+","description":"Reckless now costs 3 Hope instead of 6."}}
{"_id":"2fa8aa261b6f7c5d","name":"Control Freak","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Ken.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Ken","row":2,"expCost":400,"requirements":"Highest Crest Stat rank 4+","description":"Once per encounter, choose a target. Make a Roar check. The target makes a Core Drive check to resist. If your result is higher, they skip their next turn."}}
{"_id":"305579532fb7cca8","name":"No Sacrifice","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari S2","row":3,"expCost":800,"requirements":"Highest Crest Stat rank 6+","description":"Your Digimon can now attack normally during a round you use Untouchable."}}
{"_id":"305e83acaa257fd1","name":"Digimon Emperor","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Ken.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Ken","row":3,"expCost":900,"requirements":"Highest Crest Stat rank 6+","description":"Once between rests, at the start of your turn, you may activate Digimon Emperor. Until the end of the encounter, all enemies within 6 spaces take -3 to hit and damage. All allies within 6 spaces gain +3 to hit and damage."}}
{"_id":"32e8dc7619be8f46","name":"Untouchable","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari S2","row":1,"expCost":300,"requirements":"Highest Crest Stat rank 2+","description":"Once between rests, at the start of a round, you may spend 10 Hope. If you do, your partner Digimon negates all damage and effects that would be applied to them this round. Your Digimon cannot attack during a round you use this ability."}}
{"_id":"40817d7b4b38bf1e","name":"Exploit Weakness","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Ken.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Ken","row":2,"expCost":450,"requirements":"Highest Crest Stat rank 4+","description":"Opportunist now triggers on a natural roll of 1 through 5, not just a natural 1."}}
{"_id":"4a7411220e578321","name":"Overtime","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Davis.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Davis","row":3,"expCost":750,"requirements":"Courage rank 6+","description":"Whenever your Digimon undergoes a timed digivolution, such as a DNA Digivolution or an Item Digivolution, that digivolution lasts 2 additional rounds beyond its normal duration."}}
{"_id":"5549bbdb1b951ef0","name":"Optimal Angle","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Cody.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Cody","row":3,"expCost":750,"requirements":"Reliability rank 6+","description":"As a Free Action on your turn, spend 2 Hope. Choose one enemy within 4 spaces of your Digimon. Make a Zero Error check, DN 12. On a success, you identify the optimal attack angle: your Digimon's next attack against that enemy ignores half that enemy's Love-based Damage Reduction, rounded down."}}
{"_id":"587f431514e32ace","name":"Brace for Impact","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Davis.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Davis","row":2,"expCost":450,"requirements":"Courage rank 4+","description":"Once per round, declared before your attack roll: if your Digimon is targeted by an attack this round, your Digimon's attack gains 1d8 to its damage, and the damage you take from that attack is reduced by 1d12, down to as low as 0."}}
{"_id":"60b89a6c07dabc33","name":"No Limits","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Ken.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Ken","row":3,"expCost":800,"requirements":"Highest Crest Stat rank 6+","description":"Opportunist no longer uses your Free Action, and it can trigger on every miss within range, not just once."}}
{"_id":"6569a6f65288f9b4","name":"Constant Watch","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yolei.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yolei","row":2,"expCost":500,"requirements":"Love rank 4+","description":"Guardian's Reach can be used once per round."}}
{"_id":"a3ebdb3c411f0e7f","name":"Guard Stance","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Cody.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Cody","row":1,"expCost":250,"requirements":"Reliability rank 2+","description":"As a Free Action, your partner Digimon may enter a stance. Until the start of your next turn, the damage your Digimon deals is reduced by your Reliability rank, but their Miss Threshold increases by an additional amount equal to your Reliability rank as well."}}
{"_id":"a5b94b0318ac73ba","name":"Never Alone","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yolei.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yolei","row":3,"expCost":750,"requirements":"Love rank 6+","description":"Once between rests, restore Hope equal to twice your Love rank to every ally."}}
{"_id":"ac45abcac2ce6754","name":"Never Go Dark","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kari_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kari S2","row":3,"expCost":900,"requirements":"Highest Crest Stat rank 6+","description":"Once per encounter, when your partner Digimon would dark digivolve, you may instead spend Hope equal to the full Hope cost of their current stage. If you do, the dark digivolution is prevented and they hold their current stage normally."}}
{"_id":"b3387dcc5d5f2a76","name":"No Brakes","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Davis.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Davis","row":3,"expCost":800,"requirements":"Courage rank 6+","description":"Reckless's bonus die now applies to your damage rolls as well as your hit rolls. If your attack misses, enemies do not gain the bonus from Reckless this round."}}
{"_id":"b41c793a6e49cd7e","name":"Reckless","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Davis.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Davis","row":1,"expCost":250,"requirements":"Courage rank 2+","description":"Once per round, you may spend 6 Hope. If you do, your partner Digimon acts first in the round, before anyone else takes their turn. When your Digimon attacks this round, they gain 1d4 to their hit roll. Any enemy that attacks your Digimon this round gains that same 1d4 bonus to their hit roll as well."}}
{"_id":"c58afe6abd34dc7c","name":"Wider Reach","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Ken.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Ken","row":2,"expCost":450,"requirements":"Highest Crest Stat rank 4+","description":"Opportunist's range increases from 3 spaces to 6 spaces."}}
{"_id":"c69eda7f734ba169","name":"Exploit the Opening","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Cody.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Cody","row":2,"expCost":450,"requirements":"Reliability rank 4+","description":"When you use Guard Stance, all enemies within 3 spaces of your Digimon also have their Miss Threshold reduced by your Reliability rank. This lasts until the start of your next turn."}}
{"_id":"ca74a9cb853154be","name":"Constant Beacon","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK S2","row":3,"expCost":800,"requirements":"Highest Crest Stat rank 6+","description":"Hope Beacon is no longer limited to once between rests. You may use it once per round instead."}}
{"_id":"d57e3f9809f9c0c1","name":"Guarded Together","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Cody.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Cody","row":3,"expCost":800,"requirements":"Reliability rank 6+","description":"When you use Guard Stance, all allies within 3 spaces of your Digimon also gain a bonus to their Miss Threshold equal to your Reliability rank. This lasts until the start of your next turn."}}
{"_id":"d76d3da65d83b56e","name":"Guardian's Reach","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yolei.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yolei","row":1,"expCost":250,"requirements":"Love rank 2+","description":"Once per encounter, you may spend 6 Hope. If you do, you and all allies within 3 spaces of you gain a bonus to Damage Reduction equal to your Love rank. This bonus lasts until the start of your next turn."}}
{"_id":"d77bcfccf9105b6e","name":"Wider Net","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yolei.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yolei","row":2,"expCost":400,"requirements":"Love rank 4+","description":"Guardian's Reach's range increases from 3 spaces to 6 spaces."}}
{"_id":"d7e16588ec53043e","name":"Hope Beacon","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tk_S2.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"TK S2","row":1,"expCost":250,"requirements":"Highest Crest Stat rank 2+","description":"Once between rests, at the start of a round, you may pay 25 Hope. If you do, you and all allies who start their turn within 6 spaces of you do not have to pay a Hope cost to maintain their Digimon's digivolution this round."}}
{"_id":"d9b46b287d26787a","name":"Sharp Eyes","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yolei.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yolei","row":2,"expCost":400,"requirements":"Love rank 4+","description":"When you make a Radar check, add 1d4 to the result."}}
{"_id":"eaa39e49668b41b1","name":"Full Shield","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yolei.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yolei","row":3,"expCost":800,"requirements":"Love rank 6+","description":"Guardian's Reach's Damage Reduction bonus increases from your Love rank to twice your Love rank."}}
