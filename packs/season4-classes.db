{"_id":"0822b95833a3ff42","name":"Wide Arc","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Takuya.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Takuya","row":3,"expCost":650,"requirements":"Courage rank 6+","description":"When your partner Digimon makes a melee attack, they can hit up to 2 targets in range with that one attack instead of just one."}}
{"_id":"0d9b7803d2b95c97","name":"The Right Move","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Koji.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Koji","row":3,"expCost":700,"requirements":"Reliability rank 6+","description":"Once per session, after your partner Digimon's attack roll connects, you may deal maximum damage instead of rolling. This is used after the hit roll, once you already know the result. If the attack roll was a critical hit, the maximum damage includes crit damage. If it wasn't a critical hit, it doesn't."}}
{"_id":"1b9a45a634e2a5e8","name":"Steady Reserve","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Koji.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Koji","row":2,"expCost":450,"requirements":"Reliability rank 4+","description":"United Front now costs a flat 2 Hope per use instead of Hope equal to your Reliability rank."}}
{"_id":"24f56e909bec863d","name":"Shared Suffering","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kouichi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kouichi","row":1,"expCost":300,"requirements":"Highest Crest Stat rank 3+","description":"Once per round, when your partner Digimon takes damage, you may choose to spend 4 Hope and have them take double that damage instead. If you do, the attacker takes the original, non-doubled amount of damage themselves."}}
{"_id":"2792870c5b2f042c","name":"Hype Squad","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/JP.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"JP","row":3,"expCost":700,"requirements":"Friendship rank 6+","description":"Once per encounter, restore Hope equal to your Friendship rank to one other allied Tamer."}}
{"_id":"2e352c0a6cbe77de","name":"Iron Will","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tommy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tommy","row":2,"expCost":450,"requirements":"Sincerity rank 4+","description":"Brace Up now reduces damage by double the amount you rolled."}}
{"_id":"3247a3a342c6b433","name":"Unshakeable","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tommy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tommy","row":3,"expCost":750,"requirements":"Sincerity rank 6+","description":"Brace Up is no longer limited to once per round. You may use it as often as you like."}}
{"_id":"3605dc8d2f6917ff","name":"Fighting Alone","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Takuya.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Takuya","row":1,"expCost":300,"requirements":"Courage rank 3+","description":"Once per round, when your partner Digimon gets attacked while there's no ally within 5 spaces of them, they can use a Free Action to hit back with a basic attack against whoever just attacked them. It has to be their basic attack, nothing from their signature move or their move pool."}}
{"_id":"4d6e8b3a5d623467","name":"Universal Empathy","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Zoe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Zoe","row":3,"expCost":750,"requirements":"Love rank 6+","description":"Heart to Heart now applies to all skill checks, not just Love skill checks."}}
{"_id":"4fe4bb5796c74407","name":"Healing Wind","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Zoe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Zoe","row":3,"expCost":800,"requirements":"Love rank 6+","description":"Once per round, you may spend 8 Hope to heal all allied Digimon and Tamers within 6 spaces of you for 1d12 plus your Love rank. This is not limited beyond once per round, so it can be used again and again as long as you have the Hope to pay for it."}}
{"_id":"548a62982201ab97","name":"Open Heart","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Zoe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Zoe","row":2,"expCost":450,"requirements":"Love rank 4+","description":"Heart to Heart no longer costs Hope to use."}}
{"_id":"5bad6e693c2b6465","name":"Comforting Presence","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Zoe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Zoe","row":2,"expCost":450,"requirements":"Love rank 4+","description":"Once between rests, you may grant temporary HP equal to your Love rank to one target of your choice, including yourself."}}
{"_id":"5c39de548e8f8748","name":"Never Left Standing","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Takuya.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Takuya","row":3,"expCost":700,"requirements":"Courage rank 6+","description":"Fighting Alone stops being limited to once per round. Your partner Digimon can use it every single time they get attacked while no ally is nearby."}}
{"_id":"5c5dc5c6059d0ef3","name":"Endless Compassion","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Zoe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Zoe","row":2,"expCost":450,"requirements":"Love rank 4+","description":"Heart to Heart is no longer limited to once between rests. You may use it as many times as you like."}}
{"_id":"6271b398d0e2a8b9","name":"Better Than Fine","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/JP.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"JP","row":3,"expCost":750,"requirements":"Friendship rank 6+","description":"When your partner Digimon uses All Eyes on Me, the allied Digimon who would have taken the damage is healed for half that amount instead."}}
{"_id":"648437bc24045f21","name":"Rally Point","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Koji.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Koji","row":3,"expCost":700,"requirements":"Reliability rank 6+","description":"When you use United Front, every allied Digimon within range gains the same damage bonus on their next attack, not just your partner."}}
{"_id":"6be84dc4b4cd67ce","name":"Closer Alone","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Takuya.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Takuya","row":2,"expCost":450,"requirements":"Courage rank 4+","description":"Fighting Alone's range tightens up. Instead of needing no ally within 5 spaces, it now only needs no ally within 3 spaces to trigger."}}
{"_id":"70b4b94dcc513b9a","name":"Feeds on Darkness","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kouichi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kouichi","row":2,"expCost":450,"requirements":"Highest Crest Stat rank 4+","description":"When your partner Digimon would take Dark-type damage, they heal for that amount instead of taking damage."}}
{"_id":"7e4430ae6f1011ef","name":"Heart to Heart","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Zoe.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Zoe","row":1,"expCost":300,"requirements":"Love rank 3+","description":"Once between rests, when making a Love skill check, you may spend 4 Hope to add your Love rank to the roll."}}
{"_id":"8a8dfc78dcbd81a5","name":"Force the Outcome","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kouichi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kouichi","row":3,"expCost":750,"requirements":"Highest Crest Stat rank 6+","description":"You may spend 4 Hope to turn a missed attack roll into a hit. This cannot turn it into a critical hit."}}
{"_id":"8fb01f44135180e0","name":"Twice the Pain","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kouichi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kouichi","row":3,"expCost":750,"requirements":"Highest Crest Stat rank 6+","description":"The attacker now takes double the reflected damage instead of just the original amount."}}
{"_id":"9351db61c53f8e79","name":"Extended Bond","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Koji.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Koji","row":2,"expCost":450,"requirements":"Reliability rank 4+","description":"United Front's range increases from 3 spaces to 6 spaces."}}
{"_id":"9906ca5745a08f75","name":"First to Move","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Takuya.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Takuya","row":2,"expCost":450,"requirements":"Courage rank 4+","description":"At the start of each round, your partner Digimon can move up to 2 spaces by spending 4 Hope."}}
{"_id":"9de846130fed51d9","name":"Numb to It","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kouichi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kouichi","row":2,"expCost":450,"requirements":"Highest Crest Stat rank 4+","description":"Your partner Digimon now only takes the normal amount of damage instead of double, while the attacker still takes that same amount back."}}
{"_id":"9f3df11a8e3be368","name":"Deep Breath","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tommy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tommy","row":2,"expCost":450,"requirements":"Sincerity rank 4+","description":"You may spend 4 Hope to add 1d8 to your next roll."}}
{"_id":"aa7caf06dfc92d86","name":"Precise Form","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Koji.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Koji","row":2,"expCost":500,"requirements":"Reliability rank 4+","description":"Once per encounter, your partner Digimon may reroll one attack roll and take the higher result."}}
{"_id":"b3e6cc516d01de85","name":"United Front","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Koji.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Koji","row":1,"expCost":300,"requirements":"Reliability rank 3+","description":"When an allied Digimon is within 3 spaces of your partner Digimon, you may spend Hope equal to your Reliability rank to add your Reliability rank to your partner Digimon's damage roll."}}
{"_id":"ba6b6a0b74b49597","name":"Shrug It Off","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/JP.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"JP","row":2,"expCost":450,"requirements":"Friendship rank 4+","description":"When your partner Digimon takes damage redirected by All Eyes on Me, reduce that damage by your Friendship rank."}}
{"_id":"be2f58e8bafbf776","name":"Taunt","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/JP.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"JP","row":2,"expCost":450,"requirements":"Friendship rank 4+","description":"As a Basic Action, every opposing Digimon within range must attack your partner Digimon. This effect lasts until the start of your next turn."}}
{"_id":"d259eb77b240417c","name":"Every Strike","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Kouichi.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Kouichi","row":2,"expCost":450,"requirements":"Highest Crest Stat rank 4+","description":"Shared Suffering is no longer limited to once per round. It can trigger on every attack."}}
{"_id":"d7ef7817260dcf83","name":"Brace Up","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tommy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tommy","row":1,"expCost":300,"requirements":"Sincerity rank 3+","description":"Once per round, when you or your partner Digimon takes damage, you may spend 6 Hope to make a Reinforce check against DN 10. If you succeed, reduce that damage by the amount you rolled."}}
{"_id":"d92cc8fe7858dbe9","name":"Bigger Spotlight","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/JP.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"JP","row":2,"expCost":450,"requirements":"Friendship rank 4+","description":"All Eyes on Me's range increases from 3 spaces to 6 spaces."}}
{"_id":"dd5530161116a2d7","name":"I've Got You","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tommy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tommy","row":3,"expCost":800,"requirements":"Sincerity rank 6+","description":"When an allied Tamer fails a Sincerity skill check, you may spend 6 Hope to let them pass that check instead."}}
{"_id":"e812fe0865df89df","name":"Strike on the Move","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Takuya.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Takuya","row":2,"expCost":500,"requirements":"Courage rank 5+","description":"When your partner Digimon uses Fighting Alone, they can hit back with their signature move or something from their move pool instead of just their basic attack."}}
{"_id":"f69e8cf171d3f82d","name":"Efficient Resolve","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Tommy.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Tommy","row":2,"expCost":450,"requirements":"Sincerity rank 4+","description":"Brace Up's Hope cost decreases from 6 to 2."}}
{"_id":"f7d0bb7f54744a00","name":"All Eyes on Me","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/JP.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"JP","row":1,"expCost":300,"requirements":"Friendship rank 3+","description":"Once per round, when an allied Digimon within 3 spaces of your partner Digimon would take damage, your partner Digimon may take that damage instead. The damage is taken exactly as the original target would have taken it. It is not reduced or increased by your partner Digimon's own stats, resistances, or other abilities unless a specific ability says otherwise."}}
