{"_id":"0f5bc00ff62bbe68","name":"Going Down Swinging","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Marcus.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Marcus","row":3,"expCost":900,"requirements":"Courage rank 6+","description":"When your partner Digimon is reduced to 0 HP or less, before any other effects of reaching 0 HP apply, they may immediately make one attack, using any move currently available to them. Once that attack resolves, the Cascade and every other normal effect of reaching 0 HP take place as usual."}}
{"_id":"0ff45e6b1629a126","name":"First In","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Marcus.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Marcus","row":2,"expCost":450,"requirements":"Courage rank 4+","description":"At the start of each round, your partner Digimon can move up to 2 spaces."}}
{"_id":"122c6c1096663092","name":"Open Season","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Thomas.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Thomas","row":3,"expCost":900,"requirements":"Knowledge rank 6+","description":"Any attack made against the Marked Target by an allied Tamer or an allied Digimon gains a bonus equal to your Knowledge rank to both its hit roll and its damage."}}
{"_id":"26f80956008fe34a","name":"Haymaker","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Marcus.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Marcus","row":2,"expCost":450,"requirements":"Courage rank 4+","description":"Your Basic Attack's PR increases by 2."}}
{"_id":"287133c84384f6a3","name":"Next One's Mine","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Thomas.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Thomas","row":2,"expCost":400,"requirements":"Knowledge rank 4+","description":"Once the Marked Target is defeated, you may immediately mark a new target, following all of Mark Target's normal rules, even though you've already used it this encounter."}}
{"_id":"326d26f6d9e19e40","name":"Set the Board","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Thomas.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Thomas","row":3,"expCost":800,"requirements":"Knowledge rank 6+","description":"At the start of an encounter, you may make a Command check against DN 10. On a success, you may move one enemy and one ally 2 spaces each before the encounter's first round begins."}}
{"_id":"3e082f43e21a2d2e","name":"Back in It","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yoshino.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yoshino","row":2,"expCost":500,"requirements":"Reliability rank 5+","description":"Once per encounter, when an allied Tamer or Digimon has been removed from the encounter, whether they dropped to 0 HP or chose to submit, you may spend your Basic Action to make a Recovery check. That ally immediately returns to the fight with HP equal to the result of your check."}}
{"_id":"40e9422c72e9deca","name":"One Pack","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Keenan.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Keenan","row":3,"expCost":900,"requirements":"Friendship rank 6+","description":"Pack Instinct's bonus damage now applies to every allied Digimon within range, not just your partner. This entire class runs on being near your partner Digimon; if you're playing with the Spirit Tamer rule, Keenan has no separate partner Digimon to stand next to since he is the Digimon, so he's not able to take this class."}}
{"_id":"41be577ea5af71a6","name":"No Cost to Know","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Thomas.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Thomas","row":2,"expCost":400,"requirements":"Knowledge rank 4+","description":"Mark Target no longer costs Hope to use."}}
{"_id":"4918715f939e080d","name":"Pack Instinct","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Keenan.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Keenan","row":1,"expCost":300,"requirements":"Friendship rank 3+","description":"While you're within 2 spaces of your partner Digimon, their attacks deal an additional 1d4 damage."}}
{"_id":"4b332a1c3b483b4f","name":"Full Answer","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yoshino.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yoshino","row":2,"expCost":450,"requirements":"Reliability rank 4+","description":"When your partner Digimon retaliates with Guardian's Answer, they may use their signature move or any move from their move pool instead of their Basic Attack."}}
{"_id":"52417e46b59f52d3","name":"All In","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yoshino.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yoshino","row":2,"expCost":450,"requirements":"Reliability rank 4+","description":"When your partner Digimon retaliates with Guardian's Answer, you may spend Hope to boost that attack's hit roll. Every 1 Hope spent grants +2 to the hit roll, up to a maximum of 5 Hope spent for +10."}}
{"_id":"5da41c13ea12d0d8","name":"Pounce First","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Keenan.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Keenan","row":2,"expCost":500,"requirements":"Friendship rank 4+","description":"Once per encounter, when an enemy within range of your partner Digimon declares an attack against a target other than your partner Digimon, you may spend 4 Hope to have your partner Digimon make an attack as a Free Action against that enemy before their attack resolves."}}
{"_id":"6444a6961d331d02","name":"All the Way In","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Marcus.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Marcus","row":2,"expCost":450,"requirements":"Courage rank 4+","description":"The Hope you regain from Digisoul Charge doubles. You now regain Hope equal to the full damage dealt instead of half."}}
{"_id":"689e74f678348822","name":"Never Stops","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yoshino.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yoshino","row":3,"expCost":900,"requirements":"Reliability rank 6+","description":"Guardian's Answer no longer costs a Free Action, and it's no longer limited to once per round. Your partner Digimon can retaliate every single time an ally within range is hit, as many times as it happens."}}
{"_id":"90de49497a1ae897","name":"Data Trail","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Thomas.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Thomas","row":2,"expCost":400,"requirements":"Knowledge rank 4+","description":"As long as you've found somewhere the Digimon you're looking for has actually been, you may make a Trace check against DN 8 to figure out where they went from there."}}
{"_id":"99c2f13342a92819","name":"Mark Target","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Thomas.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Thomas","row":1,"expCost":300,"requirements":"Knowledge rank 3+","description":"Once per encounter, as a Free Action, you may spend 4 Hope to mark one enemy you can see as the Marked Target. That enemy's current HP total is immediately revealed to your whole party and updates visibly whenever it changes. The Mark lasts until that enemy is defeated or the encounter ends."}}
{"_id":"b0bee33797056df0","name":"Digisoul Charge","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Marcus.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Marcus","row":1,"expCost":300,"requirements":"Courage rank 3+","description":"Your Basic Attack gains an additional effect. When it hits, you regain Hope equal to half the damage dealt, rounded down."}}
{"_id":"b331faa00e5cfba6","name":"One of Us","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Keenan.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Keenan","row":3,"expCost":900,"requirements":"Friendship rank 6+","description":"Once between rests, you may make a Rally check against a wild Digimon, DN 12. On a success, that Digimon fights alongside you for one round, and you gain control of them for that round. You cannot make them take any action that would harm themselves, and you cannot make them act against their core nature, such as forcing them to attack a Digimon they care about."}}
{"_id":"b5498d4120b26f5c","name":"Wider Range","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Keenan.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Keenan","row":2,"expCost":450,"requirements":"Friendship rank 4+","description":"Pack Instinct's range increases from 2 spaces to 6 spaces."}}
{"_id":"e148da602768a7e9","name":"Harder Bite","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Keenan.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Keenan","row":2,"expCost":450,"requirements":"Friendship rank 4+","description":"Pack Instinct's bonus damage die increases from 1d4 to 1d8."}}
{"_id":"ea10e35e7f612ad7","name":"Share the Load","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yoshino.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yoshino","row":3,"expCost":900,"requirements":"Reliability rank 6+","description":"As a Free Action, you may decrease up to 3 of your own Crest Stats by 1 each. For every stat you decrease this way, choose one allied Tamer and increase that same Crest Stat by 1 for them. These changes last until you undo them. As a Free Action at any time, you may undo Share the Load entirely, immediately restoring your own Crest Stats and removing the bonus from every ally who received one."}}
{"_id":"f43e819107c293e5","name":"Guardian's Answer","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Yoshino.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Yoshino","row":1,"expCost":300,"requirements":"Reliability rank 3+","description":"Once per round, when an allied Tamer or Digimon within 5 spaces of your partner Digimon is hit by an attack, you may spend 2 Hope to have your partner Digimon use a Free Action to hit back with a Basic Attack against whoever just attacked them."}}
{"_id":"fb8f285110193a43","name":"One-Two Punch","type":"classSkill","img":"systems/digital-destiny/assets/DigiDestined/Marcus.webp","effects":[],"flags":{},"folder":null,"sort":0,"ownership":{"default":0},"system":{"class":"Marcus","row":3,"expCost":900,"requirements":"Courage rank 6+","description":"Once per round, when you use your Basic Action to make your Basic Attack, you may make it twice instead of once. Resolve each attack separately, including Digisoul Charge's Hope return on each one that hits."}}
